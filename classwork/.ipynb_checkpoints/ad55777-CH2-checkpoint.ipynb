    "\n",
    "def tobase2(x):\n",
    "    bit = []\n",
    "    while(x>0):\n",
    "        i = 0\n",
    "        bit[i] = x % 2\n",
    "        x = int(x)/2\n",
    "        i += 1\n",
    "\n",
    "    return bit        \n",
