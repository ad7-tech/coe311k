   "source": [
    "import random\n",
    "    \n",
    "def montecarlo(s):\n",
    "    \n",
    "    counter = 0\n",
    "\n",
    "    for i in range(0,s):\n",
    "        x = random.uniform(-1,1)\n",
    "        y = random.uniform(-1,1)\n",
    "        \n",
    "        if (x*x + y*y <1):\n",
    "            counter+=1\n",
    "        \n",
    "    return 4*counter/s\n",
    "    "
   ]
  },
