    "sinappf = 0\n",
    "\n",
    "for n in range (0,4):\n",
    "    \n",
    "    for x in range (0,10):\n",
    "        \n",
    "        sinapp = ((-1)**n * x**(2*n+1))/math.factorial((2*n+1))\n",
    "        sinappf += sinapp\n",
    "        print (np.sin(x), sinappf)\n"
   ]
